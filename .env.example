# Copy to .env.local for local development. On Netlify, set these under
# Site configuration > Environment variables. Never commit real keys.

# ── Public (safe in the browser) ─────────────────────────────
# Public URL of the live site (canonical URLs, sitemap, Open Graph, email links)
NEXT_PUBLIC_SITE_URL=https://coetara-forge.netlify.app
# Google Tag Manager container (GA4 is configured inside GTM). Leave empty to disable.
NEXT_PUBLIC_GTM_ID=
# Optional override for where forms POST. Leave empty to use the built-in
# /api/apply and /api/contact functions (with Netlify Forms as fallback).
NEXT_PUBLIC_FORM_ENDPOINT=
# Supabase project URL and publishable key (sb_publishable_..., or the legacy anon key),
# used only by the /review dashboard sign-in
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server only (Netlify Functions) ──────────────────────────
# Optional; defaults to NEXT_PUBLIC_SUPABASE_URL
SUPABASE_URL=
# Secret key (sb_secret_..., or the legacy service_role key). Bypasses row-level
# security; only ever used inside functions.
SUPABASE_SERVICE_ROLE_KEY=
# Secret. From resend.com > API Keys.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Coetara Forge <forge@coetara.com>"
FORGE_FROM_EMAIL=
# Inbox for new submissions. Comma-separate several addresses.
FORGE_TEAM_EMAIL=
# Optional routing. Each falls back to FORGE_TEAM_EMAIL when empty.
FORGE_APPLICATIONS_EMAIL=
FORGE_PARTNERS_EMAIL=
FORGE_INVESTORS_EMAIL=
# Optional Cloudflare Turnstile secret for extra spam protection
TURNSTILE_SECRET_KEY=
