# Copy to .env.local for local development. On your host, set these as
# environment variables. NEXT_PUBLIC_* values are visible in the browser,
# so never put secrets in them.

# Public URL of the website (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Django API as the browser reaches it (used by the contact form)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: Django API as the Next.js server reaches it (e.g. an internal
# network address). Defaults to NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=

# Seconds the server caches API content before refetching
API_REVALIDATE_SECONDS=60

# Set to "true" to keep search engines away (staging/preview deployments)
NEXT_PUBLIC_NOINDEX=false
