# Copy to .env for local development. In production set real environment
# variables in your host instead, and never commit real secrets.

# ── Core ───────────────────────────────────────────────────────────
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Path of the staff admin (keep the trailing slash)
DJANGO_ADMIN_URL_PATH=admin/

# ── Database (PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgres://haelsoft:haelsoft@localhost:5432/haelsoft

# ── Frontend access ────────────────────────────────────────────────
# Exact origins of the Next.js site, comma separated. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=

# ── Media ──────────────────────────────────────────────────────────
# Public base URL for uploaded images in API responses (empty = from the request)
MEDIA_PUBLIC_BASE_URL=

# ── Contact form ───────────────────────────────────────────────────
CONTACT_THROTTLE_RATE=5/hour
# Staff inboxes notified of new enquiries (comma separated). Empty = store only.
CONTACT_NOTIFICATION_EMAILS=
ADMIN_BASE_URL=http://localhost:8000/admin
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# ── Production only ────────────────────────────────────────────────
# Number of trusted proxies in front of Django (for client IPs in rate limiting)
DJANGO_NUM_PROXIES=0
DJANGO_BEHIND_TLS_PROXY=true
ENABLE_API_DOCS=false
# Shared cache so rate limits work across processes, e.g.
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://localhost:6379/1

# Show records created by `manage.py seed_demo`. Keep false in production.
SHOW_DEMO_CONTENT=false
